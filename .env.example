# Wecomm Azure PostgreSQL via SSH tunnel
# localhost:5433 -> wecomm.postgres.database.azure.com:5432
# Keep SSH tunnel running before starting the API.

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=postgres
DB_USERNAME=wecomm_admin
DB_PASSWORD=
DB_SSLMODE=require

# Tenant schema (wecomm_<uuid>). Paul default used if unset.
TENANT_SCHEMA=wecomm_019fafca-fa67-7393-84c4-4ec423f88c15

# Live Wecomm SQL for detect-order (set 0 to use stubs)
DETECT_ORDER_USE_LIVE_SQL=1
# Prefer nightly batch files in data/forecast_store/ (run scripts/run_nightly_forecast.py)
FORECAST_STORE_USE_BATCH=1
# Fallback if batch missing: live ADS from sales
FORECAST_STORE_USE_LIVE_SQL=1
# ADS / demand_std lookback for ROP, safety stock, ADS cover (default 90)
ADS_LOOKBACK_DAYS=90

# Per-SKU weekend/festival uplift learned from sales + India/US calendar (default on)
SKU_UPLIFT_ENABLED=1
# Coarse category-wide rules (off by default — prefer SKU learning)
UPLIFT_ENABLED=0
# Nightly lookback: 0 = all available history
FORECAST_LOOKBACK_DAYS=0
# Nightly job on Azure VM: use live Postgres (not laptop Product Sales CSVs)
FORECAST_USE_LOCAL_SALES=0

# Global LightGBM daily sales chart (models/global_lightgbm_sales_model.joblib)
USE_GLOBAL_LIGHTGBM=1
# GLOBAL_LIGHTGBM_MODEL_PATH=/opt/reorder-ai/models/global_lightgbm_sales_model.joblib

# Calendar "today" for festival scan (API host clock; not the browser)
REORDER_TZ=America/Detroit
# Optional demo override: REORDER_AS_OF=2026-08-04

# Product enrichment (POST /api/products/enrich) — fills product_name/brand/size
# Also used by invoice_agent (POST /invoice-agent/parse-invoice), mounted in-process
OPENAI_API_KEY=
# invoice_agent: main extraction model / cheap per-item normalization model
OPENAI_MODEL=gpt-5
OPENAI_NORMALIZE_MODEL=gpt-4.1-mini
